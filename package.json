{
  "name": "design-prototype-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@vitejs/plugin-react": "6.2.1",
    "adm-zip": "0.6.1",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6",
    "ts-morph": "28.0.0",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/adm-zip": "0.5.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
